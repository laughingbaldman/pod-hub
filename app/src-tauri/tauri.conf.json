{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Part Hub",
  "version": "0.1.0",
  "identifier": "com.example.parthub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hub",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https:; img-src 'self' data: blob: http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "publisher": "Example Shop",
    "category": "Business",
    "shortDescription": "Shop hub client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine"
      },
      "wix": {
        "upgradeCode": "d3dd3538-abbc-58e7-ab6f-74a3374562ab"
      }
    },
    "linux": {
      "deb": {
        "section": "misc"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
